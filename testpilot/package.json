{
  "name": "testpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous QA Engineer - AI teammate that explores, reasons, tests, verifies, and certifies software quality",
  "author": "TestPilot Team",
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test -- --run --pass-with-no-tests",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "turbo": "^2.10.10",
    "typescript": "^5.3.2",
    "typescript-eslint": "^7.5.0",
    "vitest": "^4.1.10",
    "@vitest/ui": "^4.1.10"
  }
}